# backend/.env.example — copy to backend/.env for local dev, and set the
# real values as environment variables on your host (Railway/Render/Fly) in
# production. Never commit an actual .env file.

# ---- App ----
ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash).
FRONTEND_URL=http://localhost:5500
# This backend's own public base URL — used to build the /api/download/{token} link in emails.
BACKEND_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql+psycopg://user:password@host:5432/biodata_builder

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ---- Pricing ----
# The backend is the only source of truth for price — the client cannot
# override this. Set to 100 (= ₹1) while smoke-testing live keys, then set
# to your real price before going live for real customers.
PRODUCT_PRICE_PAISE=1900

# ---- Storage (Supabase Storage / Cloudflare R2 — any S3-compatible bucket) ----
STORAGE_BUCKET=biodata-builder-pdfs
STORAGE_ENDPOINT_URL=https://xxxxxxxx.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=xxxxxxxx
STORAGE_SECRET_KEY=xxxxxxxx

# ---- Download links ----
DOWNLOAD_LINK_EXPIRY_MINUTES=1440

# ---- Email (SendGrid) ----
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
SENDGRID_API_KEY=xxxxxxxx

# ---- Rendering (defaults are fine locally; usually no need to set these) ----
# NODE_BINARY=node
# RENDER_SCRIPT_PATH=/absolute/path/to/backend/render/render.mjs
# RENDER_TIMEOUT_SECONDS=30
